<Page x:Class="HowsItGoing.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:contracts="using:HowsItGoing.Contracts"
      xmlns:converters="using:HowsItGoing.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBackgroundBrush" Color="#09090B" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#09090B" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#18181B" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#27272A" />
          <SolidColorBrush x:Key="HeadingBrush" Color="#F4F4F5" />
          <SolidColorBrush x:Key="BodyBrush" Color="#D4D4D8" />
          <SolidColorBrush x:Key="MutedBrush" Color="#71717A" />
          <SolidColorBrush x:Key="AccentBrush" Color="#A78BFA" />
          <SolidColorBrush x:Key="AccentDimBrush" Color="#7C3AED" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#27272A" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#09090B" />
          <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#18181B" />
          <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#312E81" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E4E7" />
          <SolidColorBrush x:Key="HeadingBrush" Color="#18181B" />
          <SolidColorBrush x:Key="BodyBrush" Color="#3F3F46" />
          <SolidColorBrush x:Key="MutedBrush" Color="#A1A1AA" />
          <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED" />
          <SolidColorBrush x:Key="AccentDimBrush" Color="#A78BFA" />
          <SolidColorBrush x:Key="SeparatorBrush" Color="#E4E4E7" />
          <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F4F4F5" />
          <SolidColorBrush x:Key="TabBarBackgroundBrush" Color="#F4F4F5" />
          <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#EDE9FE" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <converters:AgentToLabelConverter x:Key="AgentToLabel" />
      <converters:AgentToBrushConverter x:Key="AgentToBrush" />
      <converters:AgentToBackgroundBrushConverter x:Key="AgentToBackgroundBrush" />
      <converters:StatusToBrushConverter x:Key="StatusToBrush" />
      <converters:StatusToBackgroundBrushConverter x:Key="StatusToBackgroundBrush" />
      <converters:RelativeTimeConverter x:Key="RelativeTime" />
      <converters:AbsoluteTimeConverter x:Key="AbsoluteTime" />
      <converters:IssueStateToLabelConverter x:Key="IssueStateToLabel" />
      <converters:IssueStateToBrushConverter x:Key="IssueStateToBrush" />
      <converters:IssueStateToBackgroundBrushConverter x:Key="IssueStateToBackgroundBrush" />
      <converters:PullRequestStateToLabelConverter x:Key="PrStateToLabel" />
      <converters:PullRequestStateToBrushConverter x:Key="PrStateToBrush" />
      <converters:PullRequestStateToBackgroundBrushConverter x:Key="PrStateToBackgroundBrush" />
      <converters:CheckStatusToLabelConverter x:Key="CheckStatusToLabel" />
      <converters:CheckStatusToBrushConverter x:Key="CheckStatusToBrush" />
      <converters:CheckStatusToVisibilityConverter x:Key="CheckStatusToVisibility" />
      <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibility" />
      <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
      <converters:NumberToHashConverter x:Key="NumberToHash" />
      <converters:NumberListToHashesConverter x:Key="NumberListToHashes" />
      <converters:StringListToTextConverter x:Key="StringListToText" />
    </ResourceDictionary>
  </Page.Resources>

  <!-- MaxWidth keeps the desktop head a phone-width preview column; phones are narrower anyway. -->
  <Grid x:Name="RootLayout"
        MaxWidth="520"
        HorizontalAlignment="Left"
        Background="{ThemeResource PageBackgroundBrush}"
        RowDefinitions="Auto,Auto,*">

    <!-- ======== HEADER (below the status-bar safe area) ======== -->
    <Grid Grid.Row="0"
          Padding="16,10,16,6"
          Background="{ThemeResource HeaderBackgroundBrush}"
          ColumnDefinitions="*,Auto,Auto">
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10"
                   Height="10"
                   VerticalAlignment="Center"
                   Fill="{ThemeResource AccentBrush}" />
          <TextBlock FontSize="22"
                     FontWeight="Bold"
                     Foreground="{ThemeResource HeadingBrush}"
                     Text="How's It Going" />
        </StackPanel>
        <TextBlock Margin="18,2,0,0"
                   FontSize="12"
                   Foreground="{ThemeResource MutedBrush}"
                   Text="{Binding StatusBanner}"
                   TextWrapping="Wrap" />
      </StackPanel>

      <Button x:Name="ThemeToggleButton"
              Grid.Column="1"
              Margin="0,0,8,0"
              Padding="9"
              VerticalAlignment="Center"
              Background="{ThemeResource CardBackgroundBrush}"
              BorderBrush="{ThemeResource CardBorderBrush}"
              BorderThickness="1"
              Click="ThemeToggle_Click"
              CornerRadius="10">
        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                  FontSize="16"
                  Foreground="{ThemeResource MutedBrush}"
                  Glyph="&#xE793;" />
      </Button>

      <Button Grid.Column="2"
              Padding="16,9"
              VerticalAlignment="Center"
              Background="{ThemeResource AccentBrush}"
              Click="RefreshButton_Click"
              CornerRadius="10"
              Foreground="White">
        <TextBlock FontSize="13" FontWeight="SemiBold" Text="Refresh" />
      </Button>
    </Grid>

    <!-- ======== SEGMENTED TAB BAR ======== -->
    <Border Grid.Row="1"
            Margin="16,6,16,10"
            Padding="4"
            Background="{ThemeResource TabBarBackgroundBrush}"
            CornerRadius="12">
      <Grid ColumnDefinitions="*,*,*,*">
        <Button x:Name="TabSessions"
                HorizontalAlignment="Stretch"
                Padding="0,9"
                Background="{ThemeResource TabActiveBackgroundBrush}"
                BorderThickness="0"
                Click="Tab_Click"
                CornerRadius="9"
                Tag="0">
          <TextBlock FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource AccentBrush}"
                     Text="Sessions" />
        </Button>
        <Button x:Name="TabNotifications"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                Padding="0,9"
                Background="Transparent"
                BorderThickness="0"
                Click="Tab_Click"
                CornerRadius="9"
                Tag="1">
          <TextBlock FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource MutedBrush}"
                     Text="Alerts" />
        </Button>
        <Button x:Name="TabIssues"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                Padding="0,9"
                Background="Transparent"
                BorderThickness="0"
                Click="Tab_Click"
                CornerRadius="9"
                Tag="2">
          <TextBlock FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource MutedBrush}"
                     Text="Issues" />
        </Button>
        <Button x:Name="TabAgent"
                Grid.Column="3"
                HorizontalAlignment="Stretch"
                Padding="0,9"
                Background="Transparent"
                BorderThickness="0"
                Click="Tab_Click"
                CornerRadius="9"
                Tag="3">
          <TextBlock FontSize="12.5"
                     FontWeight="SemiBold"
                     Foreground="{ThemeResource MutedBrush}"
                     Text="New Run" />
        </Button>
      </Grid>
    </Border>

    <!-- ======== CONTENT ======== -->
    <ScrollViewer Grid.Row="2"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="16,0,16,32">

        <!-- ════════════════════════════════════════ -->
        <!-- SESSIONS PANEL                           -->
        <!-- ════════════════════════════════════════ -->
        <StackPanel x:Name="PanelSessions" Spacing="12">

          <!-- Filter card -->
          <Border Padding="14"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel Spacing="8">
              <TextBlock FontSize="11" FontWeight="SemiBold"
                         Foreground="{ThemeResource MutedBrush}"
                         Text="SEARCH" CharacterSpacing="60" />
              <TextBox Background="{ThemeResource InputBackgroundBrush}"
                       BorderThickness="0"
                       CornerRadius="8"
                       Foreground="{ThemeResource HeadingBrush}"
                       PlaceholderText="Prompt, repo, branch, or message"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       MaxHeight="48" />

              <Grid ColumnDefinitions="*,8,*" Margin="0,2,0,0">
                <StackPanel>
                  <TextBlock FontSize="11" FontWeight="SemiBold"
                             Foreground="{ThemeResource MutedBrush}"
                             Text="STATUS" CharacterSpacing="60" />
                  <ComboBox Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            CornerRadius="8"
                            ItemsSource="{Binding StatusFilters}"
                            SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="11" FontWeight="SemiBold"
                             Foreground="{ThemeResource MutedBrush}"
                             Text="AGENT" CharacterSpacing="60" />
                  <ComboBox Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            CornerRadius="8"
                            ItemsSource="{Binding AgentFilters}"
                            SelectedItem="{Binding SelectedAgent, Mode=TwoWay}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <CheckBox Content="Include archived"
                          Foreground="{ThemeResource BodyBrush}"
                          IsChecked="{Binding IncludeArchived, Mode=TwoWay}" />
                <Button Grid.Column="1"
                        Padding="14,6"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Click="RefreshButton_Click"
                        CornerRadius="8">
                  <TextBlock FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource AccentBrush}"
                             Text="Apply" />
                </Button>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Session list -->
          <ItemsControl ItemsSource="{Binding Sessions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="contracts:CodexSessionSummaryDto">
                <Border Margin="0,0,0,10"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                  <StackPanel Spacing="7">

                    <!-- chips row -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <Border Padding="8,3"
                              Background="{Binding Agent, Converter={StaticResource AgentToBackgroundBrush}}"
                              CornerRadius="6">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Agent, Converter={StaticResource AgentToBrush}}"
                                   Text="{Binding Agent, Converter={StaticResource AgentToLabel}}" />
                      </Border>
                      <Border Grid.Column="1"
                              Margin="6,0,0,0"
                              Padding="8,3"
                              Background="{Binding Status, Converter={StaticResource StatusToBackgroundBrush}}"
                              CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <Ellipse Width="7"
                                   Height="7"
                                   VerticalAlignment="Center"
                                   Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                          <TextBlock FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                     Text="{Binding Status}" />
                        </StackPanel>
                      </Border>
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}" />
                    </Grid>

                    <!-- title -->
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource HeadingBrush}"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               MaxLines="2"
                               TextWrapping="Wrap" />

                    <!-- repo + branch -->
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock FontSize="11"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="{Binding WorkingDirectory}"
                                 TextTrimming="CharacterEllipsis"
                                 MaxLines="1" />
                      <TextBlock Grid.Column="1"
                                 Margin="8,0,0,0"
                                 FontSize="11"
                                 Foreground="{ThemeResource AccentDimBrush}"
                                 Text="{Binding GitBranch}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- last message -->
                    <TextBlock FontSize="13"
                               Foreground="{ThemeResource BodyBrush}"
                               MaxLines="3"
                               Text="{Binding LastAgentMessage}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />

                    <!-- expandable full details -->
                    <Expander Padding="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Background="Transparent"
                              BorderThickness="0">
                      <Expander.Header>
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource MutedBrush}"
                                   Text="DETAILS"
                                   CharacterSpacing="60" />
                      </Expander.Header>
                      <StackPanel Margin="0,6,0,0" Spacing="6">
                        <Grid ColumnDefinitions="88,*">
                          <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Session" />
                          <TextBlock Grid.Column="1" FontSize="11"
                                     Foreground="{ThemeResource BodyBrush}"
                                     IsTextSelectionEnabled="True"
                                     Text="{Binding Id}"
                                     TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="88,*">
                          <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Source" />
                          <TextBlock Grid.Column="1" FontSize="11"
                                     Foreground="{ThemeResource BodyBrush}"
                                     Text="{Binding Source}"
                                     TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="88,*">
                          <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Directory" />
                          <TextBlock Grid.Column="1" FontSize="11"
                                     Foreground="{ThemeResource BodyBrush}"
                                     IsTextSelectionEnabled="True"
                                     Text="{Binding WorkingDirectory}"
                                     TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="88,*">
                          <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Branch" />
                          <TextBlock Grid.Column="1" FontSize="11"
                                     Foreground="{ThemeResource BodyBrush}"
                                     Text="{Binding GitBranch}"
                                     TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="88,*">
                          <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Created" />
                          <TextBlock Grid.Column="1" FontSize="11"
                                     Foreground="{ThemeResource BodyBrush}"
                                     Text="{Binding CreatedAt, Converter={StaticResource AbsoluteTime}}" />
                        </Grid>
                        <Grid ColumnDefinitions="88,*">
                          <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Updated" />
                          <TextBlock Grid.Column="1" FontSize="11"
                                     Foreground="{ThemeResource BodyBrush}"
                                     Text="{Binding UpdatedAt, Converter={StaticResource AbsoluteTime}}" />
                        </Grid>
                        <Grid ColumnDefinitions="88,*">
                          <TextBlock FontSize="11" Foreground="{ThemeResource MutedBrush}" Text="Completed" />
                          <TextBlock Grid.Column="1" FontSize="11"
                                     Foreground="{ThemeResource BodyBrush}"
                                     Text="{Binding CompletedAt, Converter={StaticResource AbsoluteTime}}" />
                        </Grid>
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource MutedBrush}"
                                   Margin="0,4,0,0"
                                   Text="LAST MESSAGE"
                                   CharacterSpacing="60" />
                        <ScrollViewer MaxHeight="320"
                                      HorizontalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                          <TextBlock FontSize="12"
                                     Foreground="{ThemeResource BodyBrush}"
                                     IsTextSelectionEnabled="True"
                                     Text="{Binding LastAgentMessage}"
                                     TextWrapping="Wrap" />
                        </ScrollViewer>
                      </StackPanel>
                    </Expander>

                    <Rectangle Height="1"
                               Fill="{ThemeResource SeparatorBrush}"
                               Margin="0,2" />

                    <!-- follow-up composer -->
                    <Grid ColumnDefinitions="*,8,Auto">
                      <TextBox AcceptsReturn="True"
                               Background="{ThemeResource InputBackgroundBrush}"
                               BorderThickness="0"
                               CornerRadius="10"
                               FontSize="13"
                               Foreground="{ThemeResource HeadingBrush}"
                               MaxHeight="96"
                               PlaceholderText="Send a follow-up…"
                               TextWrapping="Wrap" />
                      <Button Grid.Column="2"
                              Padding="14,9"
                              VerticalAlignment="Bottom"
                              Background="{ThemeResource AccentBrush}"
                              Click="SendFollowUp_Click"
                              CornerRadius="10"
                              Foreground="White">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Send" />
                      </Button>
                    </Grid>

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Bridge settings card -->
          <Border Padding="14"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel Spacing="10">
              <TextBlock FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource MutedBrush}"
                         Text="BRIDGE URL"
                         CharacterSpacing="60" />
              <TextBox Background="{ThemeResource InputBackgroundBrush}"
                       BorderThickness="0"
                       CornerRadius="8"
                       Foreground="{ThemeResource HeadingBrush}"
                       Text="{Binding BridgeBaseUrl, Mode=TwoWay}"
                       MaxHeight="48" />
              <Grid ColumnDefinitions="*,Auto">
                <CheckBox Content="Foreground monitoring"
                          Foreground="{ThemeResource BodyBrush}"
                          IsChecked="{Binding MonitoringEnabled, Mode=TwoWay}" />
                <Button Grid.Column="1"
                        Padding="14,6"
                        Background="Transparent"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        Click="SaveButton_Click"
                        CornerRadius="8">
                  <TextBlock FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{ThemeResource AccentBrush}"
                             Text="Save" />
                </Button>
              </Grid>
              <TextBlock FontSize="12"
                         Foreground="{ThemeResource AccentBrush}"
                         Text="{Binding NotificationWarning}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ════════════════════════════════════════ -->
        <!-- NOTIFICATIONS PANEL                      -->
        <!-- ════════════════════════════════════════ -->
        <StackPanel x:Name="PanelNotifications" Spacing="12" Visibility="Collapsed">

          <Border Padding="14"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel Spacing="8">
              <TextBlock FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource HeadingBrush}"
                         Text="GitHub + Releases" />
              <TextBlock FontSize="13"
                         Foreground="{ThemeResource BodyBrush}"
                         Text="{Binding RepositorySummary}"
                         TextWrapping="Wrap" />
              <TextBlock FontSize="12"
                         Foreground="{ThemeResource MutedBrush}"
                         Text="{Binding UpdateSummary}"
                         TextWrapping="Wrap" />
              <Button Margin="0,2,0,0"
                      Padding="14,6"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      BorderBrush="{ThemeResource CardBorderBrush}"
                      BorderThickness="1"
                      Click="OpenRelease_Click"
                      CornerRadius="8">
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AccentBrush}"
                           Text="Open Latest Release" />
              </Button>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding Notifications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="contracts:BridgeNotificationDto">
                <Border Margin="0,0,0,8"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource HeadingBrush}"
                                 Text="{Binding Title}"
                                 TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1"
                                 Margin="6,0,0,0"
                                 FontSize="11"
                                 Foreground="{ThemeResource MutedBrush}"
                                 VerticalAlignment="Top"
                                 Text="{Binding OccurredAt, Converter={StaticResource RelativeTime}}" />
                    </Grid>
                    <TextBlock FontSize="13"
                               Foreground="{ThemeResource BodyBrush}"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                    <TextBlock FontSize="11"
                               Foreground="{ThemeResource AccentDimBrush}"
                               Text="{Binding Kind}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ════════════════════════════════════════ -->
        <!-- ISSUES PANEL                             -->
        <!-- ════════════════════════════════════════ -->
        <StackPanel x:Name="PanelIssues" Spacing="12" Visibility="Collapsed">

          <!-- Filter card -->
          <Border Padding="14"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel Spacing="8">
              <TextBlock FontSize="11" FontWeight="SemiBold"
                         Foreground="{ThemeResource MutedBrush}"
                         Text="REPOSITORIES" CharacterSpacing="60" />
              <TextBox Background="{ThemeResource InputBackgroundBrush}"
                       BorderThickness="0"
                       CornerRadius="8"
                       Foreground="{ThemeResource HeadingBrush}"
                       PlaceholderText="owner/name, owner/name"
                       Text="{Binding IssueRepositories, Mode=TwoWay}"
                       MaxHeight="48" />
              <Grid ColumnDefinitions="*,8,Auto">
                <StackPanel>
                  <TextBlock FontSize="11" FontWeight="SemiBold"
                             Foreground="{ThemeResource MutedBrush}"
                             Text="STATE" CharacterSpacing="60" />
                  <ComboBox Margin="0,4,0,0"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            CornerRadius="8"
                            ItemsSource="{Binding IssueStateFilters}"
                            SelectedItem="{Binding SelectedIssueState, Mode=TwoWay}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Padding="16,6"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource AccentBrush}"
                        Click="RefreshButton_Click"
                        CornerRadius="8"
                        Foreground="White">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="Apply" />
                </Button>
              </Grid>
              <TextBlock FontSize="12"
                         Foreground="{ThemeResource BodyBrush}"
                         Text="{Binding IssueBoardSummary}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Issues list -->
          <TextBlock FontSize="11" FontWeight="SemiBold"
                     Foreground="{ThemeResource MutedBrush}"
                     Text="ISSUES" CharacterSpacing="60" />
          <ItemsControl ItemsSource="{Binding Issues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="contracts:IssueSummaryDto">
                <Border Margin="0,0,0,10"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                  <StackPanel Spacing="7">

                    <!-- chips row -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <Border Padding="8,3"
                              Background="{Binding State, Converter={StaticResource IssueStateToBackgroundBrush}}"
                              CornerRadius="6">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding State, Converter={StaticResource IssueStateToBrush}}"
                                   Text="{Binding State, Converter={StaticResource IssueStateToLabel}}" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource AccentDimBrush}"
                                 Text="{Binding Number, Converter={StaticResource NumberToHash}}" />
                      <TextBlock Grid.Column="2"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="{Binding Repository}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}" />
                    </Grid>

                    <!-- title -->
                    <TextBlock FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource HeadingBrush}"
                               Text="{Binding Title}"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />

                    <!-- labels -->
                    <TextBlock FontSize="11"
                               Foreground="{ThemeResource AccentDimBrush}"
                               Text="{Binding Labels, Converter={StaticResource StringListToText}, ConverterParameter='🏷 '}"
                               Visibility="{Binding Labels, Converter={StaticResource CollectionToVisibility}}"
                               TextWrapping="Wrap" />

                    <!-- assignees (person) -->
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource BodyBrush}"
                               Text="{Binding Assignees, Converter={StaticResource StringListToText}, ConverterParameter='👤 '}"
                               Visibility="{Binding Assignees, Converter={StaticResource CollectionToVisibility}}"
                               TextWrapping="Wrap" />

                    <!-- working agents -->
                    <StackPanel Spacing="5"
                                Visibility="{Binding WorkingAgents, Converter={StaticResource CollectionToVisibility}}">
                      <TextBlock FontSize="11" FontWeight="SemiBold"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="WORKING" CharacterSpacing="60" />
                      <ItemsControl ItemsSource="{Binding WorkingAgents}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="contracts:AgentAssignmentDto">
                            <Grid Margin="0,0,0,3" ColumnDefinitions="Auto,*">
                              <Border Padding="8,3"
                                      VerticalAlignment="Center"
                                      Background="{Binding Agent, Converter={StaticResource AgentToBackgroundBrush}}"
                                      CornerRadius="6">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Agent, Converter={StaticResource AgentToBrush}}"
                                           Text="{Binding Agent, Converter={StaticResource AgentToLabel}}" />
                              </Border>
                              <TextBlock Grid.Column="1"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         FontSize="11"
                                         Foreground="{ThemeResource MutedBrush}"
                                         Text="{Binding Branch}"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- linked PRs -->
                    <TextBlock FontSize="11"
                               Foreground="{ThemeResource MutedBrush}"
                               Visibility="{Binding LinkedPullRequestNumbers, Converter={StaticResource CollectionToVisibility}}">
                      <Run Text="Linked PRs:" />
                      <Run Foreground="{ThemeResource AccentBrush}"
                           Text="{Binding LinkedPullRequestNumbers, Converter={StaticResource NumberListToHashes}}" />
                    </TextBlock>

                    <Button Padding="12,5"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            Click="OpenUrl_Click"
                            CornerRadius="8">
                      <TextBlock FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource AccentBrush}"
                                 Text="Open on GitHub ↗" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Pull requests list -->
          <TextBlock FontSize="11" FontWeight="SemiBold"
                     Foreground="{ThemeResource MutedBrush}"
                     Text="PULL REQUESTS" CharacterSpacing="60" />
          <ItemsControl ItemsSource="{Binding PullRequests}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="contracts:PullRequestSummaryDto">
                <Border Margin="0,0,0,10"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                  <StackPanel Spacing="7">

                    <!-- chips row -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <Border Padding="8,3"
                              Background="{Binding State, Converter={StaticResource PrStateToBackgroundBrush}}"
                              CornerRadius="6">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding State, Converter={StaticResource PrStateToBrush}}"
                                   Text="{Binding State, Converter={StaticResource PrStateToLabel}}" />
                      </Border>
                      <TextBlock Grid.Column="1"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 FontSize="12"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource AccentDimBrush}"
                                 Text="{Binding Number, Converter={StaticResource NumberToHash}}" />
                      <TextBlock Grid.Column="2"
                                 Margin="8,0,0,0"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="{Binding Repository}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="{Binding UpdatedAt, Converter={StaticResource RelativeTime}}" />
                    </Grid>

                    <!-- title -->
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource HeadingBrush}"
                               Text="{Binding Title}"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />

                    <!-- checks + branch -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Padding="8,3"
                              Visibility="{Binding Checks, Converter={StaticResource CheckStatusToVisibility}}"
                              CornerRadius="6"
                              BorderThickness="1"
                              BorderBrush="{Binding Checks, Converter={StaticResource CheckStatusToBrush}}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding Checks, Converter={StaticResource CheckStatusToBrush}}"
                                   Text="{Binding Checks, Converter={StaticResource CheckStatusToLabel}}" />
                      </Border>
                      <TextBlock VerticalAlignment="Center"
                                 FontSize="11"
                                 Foreground="{ThemeResource AccentDimBrush}"
                                 Text="{Binding HeadBranch}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- author -->
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource BodyBrush}"
                               Visibility="{Binding Author, Converter={StaticResource StringToVisibility}}">
                      <Run Text="👤" />
                      <Run Text="{Binding Author}" />
                    </TextBlock>

                    <!-- working agents -->
                    <StackPanel Spacing="5"
                                Visibility="{Binding WorkingAgents, Converter={StaticResource CollectionToVisibility}}">
                      <TextBlock FontSize="11" FontWeight="SemiBold"
                                 Foreground="{ThemeResource MutedBrush}"
                                 Text="WORKING" CharacterSpacing="60" />
                      <ItemsControl ItemsSource="{Binding WorkingAgents}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="contracts:AgentAssignmentDto">
                            <Grid Margin="0,0,0,3" ColumnDefinitions="Auto,*">
                              <Border Padding="8,3"
                                      VerticalAlignment="Center"
                                      Background="{Binding Agent, Converter={StaticResource AgentToBackgroundBrush}}"
                                      CornerRadius="6">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Agent, Converter={StaticResource AgentToBrush}}"
                                           Text="{Binding Agent, Converter={StaticResource AgentToLabel}}" />
                              </Border>
                              <TextBlock Grid.Column="1"
                                         Margin="8,0,0,0"
                                         VerticalAlignment="Center"
                                         FontSize="11"
                                         Foreground="{ThemeResource MutedBrush}"
                                         Text="{Binding Status}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <!-- linked issues -->
                    <TextBlock FontSize="11"
                               Foreground="{ThemeResource MutedBrush}"
                               Visibility="{Binding LinkedIssueNumbers, Converter={StaticResource CollectionToVisibility}}">
                      <Run Text="Closes:" />
                      <Run Foreground="{ThemeResource AccentBrush}"
                           Text="{Binding LinkedIssueNumbers, Converter={StaticResource NumberListToHashes}}" />
                    </TextBlock>

                    <Button Padding="12,5"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderBrush="{ThemeResource CardBorderBrush}"
                            BorderThickness="1"
                            Click="OpenUrl_Click"
                            CornerRadius="8">
                      <TextBlock FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{ThemeResource AccentBrush}"
                                 Text="Open on GitHub ↗" />
                    </Button>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>

        <!-- ════════════════════════════════════════ -->
        <!-- NEW RUN PANEL                            -->
        <!-- ════════════════════════════════════════ -->
        <StackPanel x:Name="PanelAgent" Spacing="12" Visibility="Collapsed">

          <Border Padding="14"
                  Background="{ThemeResource CardBackgroundBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel Spacing="10">
              <TextBlock FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource HeadingBrush}"
                         Text="Start a Codex Thread" />

              <TextBlock FontSize="11" FontWeight="SemiBold"
                         Foreground="{ThemeResource MutedBrush}"
                         Text="REPO PATH" CharacterSpacing="60" />
              <TextBox Background="{ThemeResource InputBackgroundBrush}"
                       BorderThickness="0"
                       CornerRadius="8"
                       Foreground="{ThemeResource HeadingBrush}"
                       Text="{Binding AgentRepoPath, Mode=TwoWay}"
                       MaxHeight="48" />

              <Grid ColumnDefinitions="*,8,*">
                <StackPanel>
                  <TextBlock FontSize="11" FontWeight="SemiBold"
                             Foreground="{ThemeResource MutedBrush}"
                             Text="MODEL" CharacterSpacing="60" />
                  <TextBox Margin="0,4,0,0"
                           Background="{ThemeResource InputBackgroundBrush}"
                           BorderThickness="0"
                           CornerRadius="8"
                           Foreground="{ThemeResource HeadingBrush}"
                           Text="{Binding AgentModel, Mode=TwoWay}"
                           MaxHeight="48" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock FontSize="11" FontWeight="SemiBold"
                             Foreground="{ThemeResource MutedBrush}"
                             Text="REASONING" CharacterSpacing="60" />
                  <TextBox Margin="0,4,0,0"
                           Background="{ThemeResource InputBackgroundBrush}"
                           BorderThickness="0"
                           CornerRadius="8"
                           Foreground="{ThemeResource HeadingBrush}"
                           Text="{Binding AgentReasoningEffort, Mode=TwoWay}"
                           MaxHeight="48" />
                </StackPanel>
              </Grid>

              <TextBlock FontSize="11" FontWeight="SemiBold"
                         Foreground="{ThemeResource MutedBrush}"
                         Text="PROMPT" CharacterSpacing="60" />
              <TextBox AcceptsReturn="True"
                       Background="{ThemeResource InputBackgroundBrush}"
                       BorderThickness="0"
                       CornerRadius="8"
                       Foreground="{ThemeResource HeadingBrush}"
                       Height="140"
                       Text="{Binding AgentPrompt, Mode=TwoWay}"
                       TextWrapping="Wrap" />

              <Button Padding="16,9"
                      HorizontalAlignment="Left"
                      Background="{ThemeResource AccentBrush}"
                      Click="StartAgent_Click"
                      CornerRadius="10"
                      Foreground="White">
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Start Thread" />
              </Button>

              <TextBlock FontSize="12"
                         Foreground="{ThemeResource BodyBrush}"
                         Text="{Binding LaunchResult}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
