<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <ResourceDictionary.ThemeDictionaries>

    <!-- ============================================================ -->
    <!-- DARK THEME (DEFAULT) - Premium iOS-inspired dark palette     -->
    <!-- Deep blacks, subtle purple accents, high-contrast text       -->
    <!-- ============================================================ -->
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#A78BFA</Color>
      <Color x:Key="OnPrimaryColor">#1E1133</Color>
      <Color x:Key="PrimaryContainerColor">#2D2545</Color>
      <Color x:Key="OnPrimaryContainerColor">#DDD6FE</Color>

      <Color x:Key="SecondaryColor">#94A3B8</Color>
      <Color x:Key="OnSecondaryColor">#0F172A</Color>
      <Color x:Key="SecondaryContainerColor">#1E293B</Color>
      <Color x:Key="OnSecondaryContainerColor">#CBD5E1</Color>

      <Color x:Key="TertiaryColor">#67E8F9</Color>
      <Color x:Key="OnTertiaryColor">#083344</Color>
      <Color x:Key="TertiaryContainerColor">#164E63</Color>
      <Color x:Key="OnTertiaryContainerColor">#A5F3FC</Color>

      <Color x:Key="ErrorColor">#FCA5A5</Color>
      <Color x:Key="ErrorContainerColor">#7F1D1D</Color>
      <Color x:Key="OnErrorColor">#450A0A</Color>
      <Color x:Key="OnErrorContainerColor">#FECACA</Color>

      <Color x:Key="BackgroundColor">#09090B</Color>
      <Color x:Key="OnBackgroundColor">#FAFAFA</Color>

      <Color x:Key="SurfaceColor">#18181B</Color>
      <Color x:Key="OnSurfaceColor">#F4F4F5</Color>
      <Color x:Key="SurfaceVariantColor">#27272A</Color>
      <Color x:Key="OnSurfaceVariantColor">#A1A1AA</Color>

      <Color x:Key="OutlineColor">#3F3F46</Color>
      <Color x:Key="OutlineVariantColor">#27272A</Color>

      <Color x:Key="OnSurfaceInverseColor">#09090B</Color>
      <Color x:Key="SurfaceInverseColor">#FAFAFA</Color>
      <Color x:Key="PrimaryInverseColor">#7C3AED</Color>
      <Color x:Key="SurfaceTintColor">#A78BFA</Color>
    </ResourceDictionary>

    <!-- ============================================================ -->
    <!-- LIGHT THEME - Clean, airy, premium feel                      -->
    <!-- ============================================================ -->
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#7C3AED</Color>
      <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
      <Color x:Key="PrimaryContainerColor">#EDE9FE</Color>
      <Color x:Key="OnPrimaryContainerColor">#3B0764</Color>

      <Color x:Key="SecondaryColor">#475569</Color>
      <Color x:Key="OnSecondaryColor">#FFFFFF</Color>
      <Color x:Key="SecondaryContainerColor">#F1F5F9</Color>
      <Color x:Key="OnSecondaryContainerColor">#1E293B</Color>

      <Color x:Key="TertiaryColor">#0891B2</Color>
      <Color x:Key="OnTertiaryColor">#FFFFFF</Color>
      <Color x:Key="TertiaryContainerColor">#CFFAFE</Color>
      <Color x:Key="OnTertiaryContainerColor">#083344</Color>

      <Color x:Key="ErrorColor">#DC2626</Color>
      <Color x:Key="ErrorContainerColor">#FEE2E2</Color>
      <Color x:Key="OnErrorColor">#FFFFFF</Color>
      <Color x:Key="OnErrorContainerColor">#7F1D1D</Color>

      <Color x:Key="BackgroundColor">#FAFAFA</Color>
      <Color x:Key="OnBackgroundColor">#09090B</Color>

      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="OnSurfaceColor">#18181B</Color>
      <Color x:Key="SurfaceVariantColor">#F4F4F5</Color>
      <Color x:Key="OnSurfaceVariantColor">#52525B</Color>

      <Color x:Key="OutlineColor">#D4D4D8</Color>
      <Color x:Key="OutlineVariantColor">#E4E4E7</Color>

      <Color x:Key="OnSurfaceInverseColor">#FAFAFA</Color>
      <Color x:Key="SurfaceInverseColor">#18181B</Color>
      <Color x:Key="PrimaryInverseColor">#C4B5FD</Color>
      <Color x:Key="SurfaceTintColor">#7C3AED</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
